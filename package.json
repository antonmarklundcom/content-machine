{
  "name": "content-machine",
  "version": "0.3.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "description": "Web app for social media research, ideation, and copywriting across multiple brands, plus a YouTube research/digest tool.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "tsx --test-concurrency=4 --test \"src/**/*.test.ts\"",
    "test:db": "tsx --conditions=react-server --import ./tests/integration/preload.mjs --test-concurrency=1 --test \"tests/integration/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:db && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "smoke": "tsx --conditions=react-server scripts/smoke.ts",
    "db:check": "tsx scripts/check-db.ts",
    "studio:weekly": "tsx --conditions=react-server scripts/weekly-report.ts",
    "media:scan": "tsx --conditions=react-server scripts/media-scan.ts",
    "media:prune": "tsx --conditions=react-server scripts/media-prune.ts",
    "facts:import": "tsx --conditions=react-server scripts/facts-import.ts",
    "clips:fetch": "tsx --conditions=react-server scripts/clips-fetch.ts",
    "meta:sync": "tsx --conditions=react-server scripts/meta-sync.ts",
    "publish:due": "tsx --conditions=react-server scripts/publish-due.ts",
    "video:render": "tsx --conditions=react-server scripts/video-render.ts",
    "learn:process": "tsx --conditions=react-server scripts/learn-process.ts",
    "learn:nudge": "tsx --conditions=react-server scripts/learn-nudge.ts",
    "learn:import-aiinsights": "tsx --conditions=react-server scripts/learn-import-aiinsights.ts",
    "comments:sync": "tsx --conditions=react-server scripts/comments-sync.ts",
    "gaps:find": "tsx --conditions=react-server scripts/gaps-find.ts",
    "voice:test": "tsx --conditions=react-server scripts/voice-test.ts",
    "voice:dataset": "tsx --conditions=react-server scripts/voice-dataset.ts",
    "stories:import": "tsx --conditions=react-server scripts/stories-import.ts",
    "higgsfield:run": "tsx --conditions=react-server scripts/higgsfield-run.ts",
    "higgsfield:reap": "tsx --conditions=react-server scripts/higgsfield-reap.ts",
    "yt:seed-owner": "tsx scripts/seed-yt-owner.ts",
    "yt:uploads": "tsx scripts/list-uploads.ts",
    "yt:ingest": "tsx scripts/ingest.ts",
    "yt:analyze": "tsx scripts/analyze.ts",
    "yt:poll": "tsx scripts/poll-sources.ts",
    "yt:screen": "tsx scripts/screen.ts",
    "yt:backfill": "tsx scripts/backfill.ts",
    "yt:spend": "tsx scripts/spend.ts",
    "yt:probe-captions": "tsx scripts/probe-captions.ts",
    "spend:recover": "tsx --conditions=react-server scripts/spend-recover.ts",
    "test:worker": "tsx --test \"workers/telegram-capture/test/*.test.ts\"",
    "build:hostinger": "npm run build",
    "start:hostinger": "npm start",
    "artifact:check": "node scripts/validate-hostinger-artifact.mjs",
    "postbuild": "node scripts/prepare-hostinger.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "undici": "^6.28.0",
    "youtubei.js": "^13.4.0",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=11.17.0"
  }
}
