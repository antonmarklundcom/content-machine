# Hostinger uses MariaDB through the MySQL protocol. Use hPanel's exact host/database/user.
# URL-encode passwords containing @, #, /, %, etc. No real credentials belong in Git.
DATABASE_URL="mysql://user:encoded_password@host:3306/content_machine"
# Bounded per Node process; PC jobs and hosted app each have their own pool.
DB_POOL_LIMIT=5
# Optional verified TLS: append ?ssl=true when the server supports trusted TLS.
# For synthetic destructive tests ONLY: dedicated *_test name and explicit opt-in.
# DATABASE_URL="mysql://test:synthetic@127.0.0.1:3306/content_machine_test"
# ALLOW_DESTRUCTIVE_TEST_DB=1
# DB_DRIVER=mysql

# Gemini API key — used server-side by both the brand research/ideation path
# and the YouTube analysis/screening pipelines (one shared client, see
# src/lib/ai.ts). Create one at aistudio.google.com/apikey. The key must be on
# a paid (billed) project: Grounding with Google Search and the Batch API,
# which /api/generate and the nightly poller depend on, are not available on
# the free tier.
GEMINI_API_KEY=

# Optional: override the model used for brand content generation (defaults to
# gemini-3.7-flash). The YouTube analysis pipeline has its own model selection
# (Gemini 3.1 Flash-Lite by default; see src/lib/analysis/pricing.ts) and does
# not read this. Set it to gemini-3.1-flash-lite to run ideation ~6x cheaper at
# some cost in copy quality, or to gemini-3.1-pro-preview for the Pro tier.
# Rates for the models this can be set to live in IDEATION_MODEL_RATES; a model
# that isn't listed there bills at the Pro rate, so the spend cap over-counts
# rather than under-counts it.
GEMINI_MODEL=

# Answer every Gemini call from the test double in src/lib/ai-fake.ts instead
# of calling Google (PLAN.md §1.16). Set to 1 and no key is needed: the fake
# returns schema-valid responses with realistic usageMetadata and
# groundingMetadata, so the spend arithmetic is exercised rather than skipped.
# `npm run test:db` sets this for itself; nothing else should have it set.
# `npm run smoke` refuses to run with it, because canned usage figures cannot
# tell you what Google actually bills.
#
# It also turns itself on when NODE_ENV=test and there is no GEMINI_API_KEY, so
# a test run that forgets the flag fails on an assertion rather than reaching
# for a credential.
# GEMINI_FAKE=1

# Optional: override the model used to adapt a promoted idea into a brand's
# voice (POST /api/ideas/promote with adapt=true). Defaults to
# gemini-3.1-flash-lite — one paragraph rewritten from material already on file
# is not a reasoning problem, and this button gets pressed a lot.
GEMINI_PROMOTE_MODEL=

# Optional: the model that transcribes a fetched clip (always Gemini, whatever
# AI_PROVIDER says). Defaults to gemini-3.1-flash-lite.
# GEMINI_TRANSCRIBE_MODEL=

# Clip capture ---------------------------------------------------------------
# Bearer token for POST /api/clips, so a phone share sheet or iOS Shortcut can
# save a link without a session cookie (the app itself uses the cookie and
# ignores this). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Treat it like the owner's password: anyone holding it can save clips, and a
# saved YouTube clip spends money analysing itself. Unset = the Bearer path
# answers 503 and says so; saving from a signed-in browser still works.
CLIP_TOKEN=

# Media storage (PLAN.md §1.41) --------------------------------------------
# Setup, the drive letter and the Google Drive backup: docs/STORAGE.md.
# Where media files live: an external drive in the office, e.g.
#   MEDIA_ROOT=E:\ContentEngine
# Unset = `media/` next to the repo (where build 2's Higgsfield commands save).
# An unplugged drive is a normal state: the app says "media drive not
# connected" and keeps working on metadata. `npm run media:scan` registers
# what is on it (idempotent; safe hourly from Task Scheduler).
MEDIA_ROOT=

# Optional: ffprobe for video/audio durations. Found on PATH if installed;
# set this only when it is somewhere else. Without it durations stay empty.
# FFPROBE_PATH=

# The public copy on the EU Hostinger account's `media.` subdomain
# (hosting/media-upload/README.md, §7 item 6). Needed only to publish; unset,
# publishing says the endpoint is not configured and nothing else changes.
MEDIA_UPLOAD_URL=
# The same token as `token` in the endpoint's config.php (≥ 32 characters).
MEDIA_UPLOAD_TOKEN=
# What public URLs start with, no trailing slash, e.g. https://media.example.com
MEDIA_PUBLIC_BASE=
# Days a public copy stays up before `npm run media:prune` deletes it (default 90).
MEDIA_PUBLIC_RETENTION_DAYS=90

# Optional, read-only Google Drive (O14, src/lib/storage/drive.ts): lets the
# online app read files backed up by Drive for desktop, by `assets.drive_file_id`.
# An API key with the Google Drive API enabled; it reads only files shared as
# "Anyone with the link". Unset = Drive links still open, reads say "not configured".
# GOOGLE_DRIVE_API_KEY=

# ---------------------------------------------------------------------------
# YouTube research tool (ported from the standalone "yt" repo) — /youtube/*
# ---------------------------------------------------------------------------

# Login/session (required — the whole app, not just /youtube/*, is gated
# behind this login). Fails closed: unset, every request redirects to
# /youtube/login. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out immediately — the only way to revoke a
# session before its 30-day expiry.
SESSION_SECRET=

# Seed data for the owner account. Used by `npm run yt:seed-owner` only.
ADMIN_EMAIL=you@example.com
# Optional, used by `npm run yt:seed-owner` only. Sets/resets that user's
# password. Minimum 12 characters. Omit to leave the stored password
# untouched on a re-run. A user with no password set cannot log in at all.
# ADMIN_PASSWORD=

# console.cloud.google.com → APIs & Services → Credentials → Create API key,
# with "YouTube Data API v3" enabled. Free quota is 10,000 units/day.
YOUTUBE_API_KEY=
# Optional. Per-run guard against a runaway loop; not a real daily ledger.
YOUTUBE_QUOTA_BUDGET=10000

# Captions ---------------------------------------------------------------
# Ordered strategy list. Set this to whatever a passing
# `npm run yt:probe-captions` run prints from wherever this deploys, so the
# pipeline stops paying the latency of strategies known to be dead there.
# Unset = try all, in the default order from src/lib/youtube/captions/index.ts.
# This is an allowlist and a floor: adaptive health tracking (below) can prune
# it within a run, but never adds a strategy you left out.
# CAPTION_STRATEGIES=innertube-android,innertube-ios,watch-page

# Consecutive failures before a strategy is dropped for the rest of a run, so a
# dead strategy is paid for a few times instead of once per video. Default 3 —
# low enough to save real time on a blocked host, high enough that one
# age-restricted video does not retire a working strategy (the reasoning is in
# src/lib/youtube/captions/health.ts). Set 0 to always try every strategy.
# State is per-process and never persisted; a new run starts with a clean slate.
# CAPTION_FAILURE_THRESHOLD=3

# Optional outbound HTTP(S) proxy for caption fetches ONLY — nothing else in
# the app is routed through it. Unset (the default) means direct requests and
# no behaviour change at all.
#
# This exists for one scenario: YouTube refuses caption requests from
# datacenter IPs, and Vercel functions run on datacenter IPs. If
# `npm run yt:probe-captions` comes back blocked from the deployed host, paying
# a few dollars a month for a residential proxy and setting this variable is
# the cheapest of the three ways out — see docs/CAPTION-FETCH-RESILIENCE.md for
# the comparison and the numbers.
#
# Credentials go in the URL; they are redacted everywhere they are printed.
# HTTPS_PROXY/HTTP_PROXY are deliberately NOT read — routing traffic through a
# metered proxy should never happen because a host set an ambient variable.
# CAPTION_PROXY_URL=http://user:pass@residential.example.com:8080

# Preferred caption languages, best first. Manual captions always beat
# auto-generated ones regardless of this setting.
CAPTION_LANGUAGES=en

# Pause between videos in a batch, to avoid looking like a scraper to YouTube.
# Set 0 for a single interactive fetch.
CAPTION_DELAY_MS=1500

# Spend guard --------------------------------------------------------------
# Hard monthly cap in USD, covering BOTH halves of the app: the YouTube
# poller/backfill and /api/generate's research+ideation call (which is the
# expensive one — a Flash-tier model plus up to 8 paid Search groundings). The poller and backfill
# REFUSE to start a batch whose estimate would exceed this, and /api/generate
# answers 429 rather than spending over it; none of them stop halfway. Set to 0
# to block all spend.
MONTHLY_SPEND_CAP_USD=25

# Cron -----------------------------------------------------------------------
# Shared secret for POST /api/cron/poll, the endpoint an hourly cron job calls.
# Generate one and never reuse it elsewhere: openssl rand -hex 32
# The route compares this in constant time and FAILS CLOSED: if unset, the
# endpoint answers 503 rather than running an unauthenticated job that spends
# money. Send it as `x-cron-secret: <value>` or `Authorization: Bearer <value>`.
# Local first (PLAN.md §1.27): on Anton's PC the scheduler is Windows Task
# Scheduler running `npm run yt:poll` hourly (see docs/log/o6.md), which needs
# no secret — leave this unset locally and the route stays disabled. The route
# and the CLI share one `poll` lease in the database, so they never overlap.
CRON_SECRET=

# Screening — the gallring (PR-35) ------------------------------------------
# Before paying ~$0.02 to analyse a transcript, the poll run spends ~$0.001
# asking Flash-Lite, from the free metadata alone, whether it is worth it.
# The bar, 0-100. Default 50. Set to 0 to keep screening (and keep paying for
# it) while culling nothing.
# SCREEN_MIN_SCORE=50
# Set to 0/false/off to switch screening off entirely.
# SCREENING_ENABLED=1
# Optional. A few sentences about what you're actually working on right now,
# passed to the screening model verbatim.
# SCREEN_INTERESTS="Local lead-gen sites for Swedish trades and Paraguayan …"

# Subscription mode (PLAN.md §1.38, docs/SUBSCRIPTION-MODE.md) -----------------
# Who writes titles, scripts and studio reports:
#   gemini (default) — Gemini API, billed per token under the spend cap
#   claude           — the Claude Code CLI on this PC, under your Claude plan
#   codex            — the Codex CLI on this PC, under your ChatGPT plan
# YouTube digests and batch screening stay on Gemini either way (cheap, bulk).
# AI_PROVIDER=claude
# CLAUDE_CLI_MODEL=opus        # optional; default is the CLI's own default
# CLAUDE_CLI_BIN=claude        # optional; full path if `claude` is not on PATH
# CODEX_CLI_MODEL=             # optional
# CODEX_CLI_BIN=codex          # optional
# CODEX_CLI_ARGS=--search      # optional extra flags, e.g. web search if your version supports it

# Clip fetch + transcript (PLAN.md §1.44, `npm run clips:fetch`) --------------
# yt-dlp and ffmpeg are found on PATH (setup.ps1 installs both via winget);
# set a full path only if they are elsewhere.
# YTDLP_PATH=C:\tools\yt-dlp.exe
# FFMPEG_PATH=C:\tools\ffmpeg.exe
# Optional Netscape cookies file for Instagram reels that need a login.
# YTDLP_COOKIES_FILE=
# YTDLP_TIMEOUT_SEC=300
# CLIP_FETCH_MAX_MB=200
# Bot token for downloading files sent to the Telegram capture bot (Bot API,
# 20 MB limit). The Worker itself needs no token (docs/CAPTURE.md).
# TELEGRAM_BOT_TOKEN=

# Meta: Instagram + Facebook insights, later publishing (PLAN.md §1.49, O12) --
# Easiest: Settings → Meta walks through every step and writes these for you.
# From developers.facebook.com → My Apps → your app → App settings → Basic.
# META_APP_ID=
# META_APP_SECRET=
# Optional: a Facebook Login for Business configuration id (Facebook Login for
# Business → Configurations). Without it the login asks for the permissions directly.
# META_LOGIN_CONFIG_ID=
# META_GRAPH_VERSION=v23.0
# Redirect URI to add in Meta (Facebook Login for Business → Settings →
# Valid OAuth Redirect URIs): http://localhost:3000/api/meta/callback
# (and https://<your-online-host>/api/meta/callback once the app is online).
# Tokens are stored encrypted with this key: 64 hex characters (32 bytes).
# Settings → Meta creates one if it is missing. Losing it means reconnecting Meta.
# Make one by hand: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Build 4 (docs/PLAN-build4.md): voice, stories, video, learn, YouTube/TikTok
# ---------------------------------------------------------------------------
# Set APP_MODE=online on the Hostinger deploy only. Voice takes, video renders,
# story audio and Higgsfield runs then show "runs on the PC" instead of failing
# (they need ffmpeg, MEDIA_ROOT or Claude Code). Leave it empty on the PC.
# APP_MODE=
# Online (Hostinger) vs PC for each of these: docs/DEPLOY-HOSTINGER.md section 8.
# Voice, video, stories and the Higgsfield bridge run on the PC only.
#
# Voice providers (docs/VOICE.md). Each is optional; a voice profile whose
# provider has no key says so instead of failing. Guaraní (`gn`) is recorded
# by a person and uploaded (provider `manual`): no TTS service speaks it.
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Gemini TTS uses GEMINI_API_KEY above. Model override (optional):
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Voice (WAV → MP3) and video renders use ffmpeg/ffprobe: PATH, or FFMPEG_PATH /
# FFPROBE_PATH above.
# x264 speed/quality for renders (ultrafast … veryslow), default medium.
# VIDEO_X264_PRESET=medium

# cuentos.com.py repo on this PC (docs/CUENTOS.md), e.g. C:\dev\cuentos.
# `npm run stories:import` and /stories read books/<slug>/ from here.
CUENTOS_ROOT=

# Learn (merged from aiinsights, docs/LEARN.md). The weekly "implement one
# thing" nudge is sent to the first chat id in TELEGRAM_ALLOWED_CHAT_IDS.
# TELEGRAM_BOT_TOKEN and TELEGRAM_ALLOWED_CHAT_IDS are the capture bot's.
# GITHUB_TOKEN raises the README-fetch rate limit for github.com links.
# GITHUB_TOKEN=
# One-time import of the old aiinsights items (npm run learn:import-aiinsights).
# AIINSIGHTS_DATABASE_URL=
# The app's own address, used for links in Telegram messages (the nudge links
# to /learn), e.g. http://localhost:3000 or the online domain after O14.
# APP_URL=
# The Worker's weekly nudge cron also needs the bot token as a Worker secret:
#   cd workers/telegram-capture && npx wrangler secret put TELEGRAM_BOT_TOKEN

# YouTube publishing (OAuth, docs/PUBLISH-VIDEO.md). A Google Cloud OAuth
# client of type "Web application" with redirect
#   <APP_URL>/api/youtube/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# TikTok Content Posting API (needs an audited TikTok developer app for public posts).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Voice cost estimate for the spend cap (your ElevenLabs plan's price per 1,000
# characters; default 0.30). VOICE_FAKE=1 makes every voice provider a silent
# test double (no network, no cost); never set it in production.
# ELEVENLABS_USD_PER_1K_CHARS=0.30

# Build 5 (docs/PLAN-build5.md). Chatterbox clones a voice from a ~10 s sample.
# Local: run tools/chatterbox-server (Python, CPU) and point CHATTERBOX_URL at it.
# Cloud: REPLICATE_API_TOKEN (a few cents per clip). Model override optional.
# CHATTERBOX_URL=http://127.0.0.1:8004
# REPLICATE_API_TOKEN=
# CHATTERBOX_REPLICATE_MODEL=resemble-ai/chatterbox-multilingual
# Per-chunk timeout for the local server (CPU is slow), seconds.
# CHATTERBOX_TIMEOUT_SEC=900
# Replicate cost estimate per second of prediction time (UNVERIFIED rate).
# CHATTERBOX_REPLICATE_USD_PER_SEC=0.000975
# Higgsfield voice takes run through the Higgsfield bridge (no key). Credits per
# job are capped like image jobs: HIGGSFIELD_DEFAULT_MAX_CREDITS below.
# VOICE_FAKE=

# Higgsfield bridge (docs/HIGGSFIELD.md "Generate from the app") — PC only.
# The app starts the logged-in Claude Code CLI with the Higgsfield MCP; it never
# holds a Higgsfield key. CLAUDE_CLI_PATH only if `claude` is not on PATH.
# CLAUDE_CLI_PATH=
HIGGSFIELD_DEFAULT_MAX_CREDITS=20
HIGGSFIELD_JOB_TIMEOUT_MIN=30
# The MCP server's name in `claude mcp list` when it is not "higgsfield".
# HIGGSFIELD_MCP_SERVER=
# Model for the Claude run (empty = the CLI's default).
# HIGGSFIELD_CLAUDE_MODEL=
